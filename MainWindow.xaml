<Window x:Class="LightAudioConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="无损音乐兼容助手" Icon="Assets/app.ico"
        Width="760" Height="540" MinWidth="700" MinHeight="520"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        AllowsTransparency="False" Background="{StaticResource Bg}"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#101820" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="27" Height="27" CornerRadius="6" Background="#0C88A9" Margin="0,0,10,0">
                        <TextBlock Text="♪" FontFamily="Segoe UI Symbol" FontSize="17" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" Foreground="White"/>
                    </Border>
                    <TextBlock Text="无损音乐兼容助手" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="为仅支持 16-bit FLAC 的老款 MP3 与索尼 NW 系列播放器提供兼容转换"
                               Foreground="{StaticResource Muted}" FontSize="10" Margin="14,1,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI" Content="—" Width="42" Click="Minimize_Click"/>
                    <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI" Content="□" Width="42" Click="Maximize_Click"/>
                    <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI" Content="×" FontSize="20" Width="42" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="76"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="48"/>
            </Grid.RowDefinitions>

            <Border x:Name="DropZone" Grid.Row="0" Background="#101B23" BorderBrush="#188DAA"
                    BorderThickness="1" CornerRadius="8" MouseLeftButtonUp="DropZone_Click">
                <Grid>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="&#xE8E5;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}"
                                   FontSize="28" Margin="0,0,14,0"/>
                        <StackPanel>
                            <TextBlock Text="拖入音频或选择文件" FontWeight="SemiBold" FontSize="16"/>
                            <TextBlock Text="支持 FLAC、WAV、AIFF、ALAC、APE、MP3、AAC 等常见格式"
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Background="Transparent" BorderBrush="#2796AF" BorderThickness="1" CornerRadius="8"
                            Margin="0" IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="18,0" Background="#121C24">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2.1*"/>
                            <ColumnDefinition Width="1.55*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="140"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="文件名" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="源格式" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="时长" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <Grid Grid.Column="3">
                            <TextBlock Text="状态" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                            <Button x:Name="ClearButton" Content="清空列表" HorizontalAlignment="Right"
                                    Padding="9,4" FontSize="11" Foreground="#74D9ED"
                                    Background="#102832" BorderBrush="{StaticResource Accent}"
                                    BorderThickness="1" Click="Clear_Click">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Style.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.65"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView x:Name="FileList" ItemsSource="{Binding Files}" Background="Transparent"
                                  BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="48" Margin="18,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.1*"/>
                                            <ColumnDefinition Width="1.55*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="140"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="&#xE8D6;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}"
                                                       FontSize="16" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding SourceSummary}" Foreground="#B4C0C8"
                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding DurationText}" Foreground="#B4C0C8" VerticalAlignment="Center"/>
                                        <Grid Grid.Column="3">
                                            <TextBlock Text="{Binding Status}" Foreground="{StaticResource Muted}" Margin="0,0,28,0"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Button Style="{StaticResource IconButton}" FontFamily="Segoe UI" FontSize="18" Content="×" HorizontalAlignment="Right"
                                                    ToolTip="移除" Tag="{Binding}" Click="Remove_Click"/>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="尚未添加文件" Foreground="{StaticResource Muted}" HorizontalAlignment="Center"/>
                            <Button Content="选择文件" Margin="0,10,0,0" Click="AddFiles_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="4" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                    BorderThickness="1" CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,12,0"/>
                            <TextBlock Text="输出格式" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="FLAC · 16-bit · 44.1 kHz · 双声道"
                                   Foreground="{StaticResource Accent}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,1">
                        <Grid Margin="18,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,12,0"/>
                                <TextBlock Text="输出文件夹" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="OutputFolderText" Grid.Column="1" Foreground="#B4C0C8" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="浏览" Padding="18,7" Click="BrowseOutput_Click"/>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="18,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" Foreground="{StaticResource Accent}" FontSize="18" Margin="0,0,12,0"/>
                            <TextBlock Text="算法说明" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SoXR 最高精度重采样 · TPDF 抖动" Foreground="#B4C0C8"/>
                            <TextBlock x:Name="QualityDetail" Text="仅在必要时处理 · 输出 16-bit · 不做音量归一化"
                                       Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="HintText" Text="与目标格式一致的文件将跳过不必要的处理"
                               Foreground="{StaticResource Muted}" FontSize="11"/>
                    <ProgressBar x:Name="OverallProgress" Height="4" Margin="0,7,18,0" Minimum="0" Maximum="100"
                                 Foreground="{StaticResource Accent}" Background="#1A2730" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="取消" Width="82" Margin="0,0,10,0"
                            Visibility="Collapsed" Click="Cancel_Click"/>
                    <Button x:Name="ConvertButton" Content="开始转换" Width="230" FontSize="17" FontWeight="SemiBold"
                            Background="#0C9FC2" BorderBrush="#28C7E9" Click="Convert_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
